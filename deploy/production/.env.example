# Immutable image tag. deploy.sh updates this value to the released commit SHA.
IMAGE_TAG=replace-with-git-commit-sha

TCR_REGISTRY=ccr.ccs.tencentyun.com
TCR_NAMESPACE=teacher-honor
API_REPOSITORY=spotify-stats-api
WEB_REPOSITORY=spotify-stats-web

# Which loopback Web gateways are kept running: full, showcase, or dual.
# This does not configure, enable, or disable any external HTTPS ingress.
DEPLOYMENT_MODE=full

# public-readonly 入口的人类访问门禁：protected 需要用户名密码，public 直接访问。
# 不影响完全版、后端只读白名单或可信网关密钥。
SHOWCASE_ACCESS_MODE=protected

# Canonical private-admin URL, without a trailing slash. This remains the
# Spotify OAuth callback origin even when only the showcase gateway is running.
APP_PUBLIC_URL=https://spotify-stats.example-tailnet.ts.net
APP_GATEWAY_PORT=3001
PUBLIC_SHOWCASE_URL=https://spotify-stats.example-tailnet.ts.net:8443
PUBLIC_GATEWAY_PORT=3002

# Generate independently for production. Do not reuse or commit a local value.
SPOTIFY_STATS_TOKEN_KEY=replace-with-a-long-random-secret
# Generate with: openssl rand -hex 32
# The deployment scripts only accept 32-128 base64url-safe characters so the
# runtime Nginx template cannot be escaped by configuration metacharacters.
SPOTIFY_STATS_GATEWAY_TOKEN=replace-with-a-separate-long-random-secret
SPOTIFY_STATS_TRUSTED_GATEWAY_REQUIRED=1
SPOTIFY_STATS_WARMUP=1
SPOTIFY_STATS_SEARCH_STARTUP_REBUILD=1
# Host-side one-shot preflight gate. Override only after measuring the server.
SEARCH_PREFLIGHT_MIN_AVAILABLE_MIB=2560

# Optional Spotify OAuth. Register APP_PUBLIC_URL/api/spotify/auth/callback exactly
# in the Spotify Developer Dashboard before connecting from production.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional enrichment providers.
GENIUS_ACCESS_TOKEN=
GENIUS_PROXY=
LASTFM_API_KEY=
HTTPS_PROXY=
HTTP_PROXY=

# On-server SQLite backup retention.
BACKUP_RETENTION_DAYS=14
