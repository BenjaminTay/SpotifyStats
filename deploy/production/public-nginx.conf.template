limit_req_zone $binary_remote_addr zone=public_showcase_api:10m rate=10r/s;

server {
    listen 3000;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 1m;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss image/svg+xml;

    add_header Referrer-Policy "same-origin" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    auth_basic "SpotifyStats Showcase";
    auth_basic_user_file /etc/nginx/auth/showcase.htpasswd;

    # Keep container/orchestrator health probes independent from the human
    # access password. No capability or personal data is returned here.
    location = /api/health {
        auth_basic off;
        limit_req zone=public_showcase_api burst=30 nodelay;
        proxy_pass http://backend:8000/api/health;
        proxy_http_version 1.1;
        proxy_set_header X-SpotifyStats-Surface public-readonly;
        proxy_set_header X-SpotifyStats-Gateway-Token "${SPOTIFY_STATS_GATEWAY_TOKEN}";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 10s;
        proxy_connect_timeout 5s;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        try_files $uri =404;
    }

    location = /sw.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        try_files $uri =404;
    }

    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        try_files $uri =404;
    }

    location = /docs {
        return 404;
    }

    location = /openapi.json {
        return 404;
    }

    # Defence in depth: the backend owns the authoritative allowlist. These
    # blocks keep older images from exposing known private feature families.
    location ~ ^/api/(admin|ai-insights|ai/tasks|artist-identities|billboard/enrichment|chat|import|jobs|lyrics|metadata/artist-genres|metadata/artist-languages|music-metadata/track-credits|profile|search-history|spotify/auth|version-merge)(/|$) {
        return 404;
    }

    location ~ ^/api/settings/llm-profiles(/|$) {
        return 404;
    }

    location ~ ^/api/billboard/(versus/(track|album|artist)|release-cycle/compare)$ {
        limit_req zone=public_showcase_api burst=30 nodelay;
        limit_except GET HEAD OPTIONS POST {
            deny all;
        }
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header X-SpotifyStats-Surface public-readonly;
        proxy_set_header X-SpotifyStats-Gateway-Token "${SPOTIFY_STATS_GATEWAY_TOKEN}";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 180s;
        proxy_connect_timeout 10s;
    }

    location /api/ {
        limit_req zone=public_showcase_api burst=30 nodelay;
        limit_except GET HEAD OPTIONS {
            deny all;
        }
        proxy_pass http://backend:8000/api/;
        proxy_http_version 1.1;
        proxy_set_header X-SpotifyStats-Surface public-readonly;
        proxy_set_header X-SpotifyStats-Gateway-Token "${SPOTIFY_STATS_GATEWAY_TOKEN}";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 180s;
        proxy_connect_timeout 10s;
    }

    location /covers/ {
        limit_except GET HEAD OPTIONS {
            deny all;
        }
        proxy_pass http://backend:8000/covers/;
        proxy_http_version 1.1;
        proxy_set_header X-SpotifyStats-Surface public-readonly;
        proxy_set_header X-SpotifyStats-Gateway-Token "${SPOTIFY_STATS_GATEWAY_TOKEN}";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 30s;
        proxy_connect_timeout 10s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
