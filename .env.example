# ── Spotify API 凭据（必填）──────────────────────────────────────────────
# 在 https://developer.spotify.com/dashboard 创建应用后获取
# 复制此文件为 .env 并填入实际值
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# ── Spotify OAuth（可选，以下为默认值）─────────────────────────────────────
# SPOTIFY_REDIRECT_URI=http://localhost:5173/api/spotify/auth/callback

# ── Genius 歌词（可选）────────────────────────────────────────────────────
# GENIUS_ACCESS_TOKEN=your_genius_token_here
# GENIUS_PROXY=

# ── Last.fm 艺人标签补全（可选）────────────────────────────────────────────
# LASTFM_API_KEY=your_lastfm_api_key_here

# ── 网络代理（可选）───────────────────────────────────────────────────────
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897

# ── 前端 / CORS（可选，以下为默认值）───────────────────────────────────────
# FRONTEND_ORIGIN=http://localhost:5173

# ── 应用行为（可选）───────────────────────────────────────────────────────
# SPOTIFY_STATS_WARMUP=1

# ── 远程访问认证（只保护部分写端点，不能作为整站认证）───────────────────────
# SPOTIFY_STATS_REQUIRE_AUTH=0
# SPOTIFY_STATS_API_TOKEN=your_api_token_here

# ── Token 加密密钥（私人云生产环境必须设置独立随机值）────────────────────────
# SPOTIFY_STATS_TOKEN_KEY=your_encryption_key_here
